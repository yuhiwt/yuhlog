---
// src/pages/index.astro
// 1. postsフォルダ内の全mdファイルを取得
const posts = await Astro.glob('./posts/*.md');

// 2. 日付の新しい順に並び替え
const sortedPosts = posts.sort((a, b) => 
  new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>yuh</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400;700&family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#faf9f6] text-neutral-800 font-serif antialiased selection:bg-yellow-200">
    
    <main class="container mx-auto px-6 py-16 max-w-[680px]">
      
      <header class="mb-20">
        <h1 class="font-bold text-2xl tracking-tight">
          <a href="/" class="hover:text-blue-700 transition-colors">yuh</a>
        </h1>
      </header>

      <article class="prose prose-neutral prose-lg prose-headings:font-normal hover:prose-a:text-blue-700 prose-a:no-underline hover:prose-a:underline prose-a:transition-colors">
        
        <section class="mb-16">
          <p>
            東京で活動しています。<br>
            物理空間と仮想空間の交差点についてなんか書いています。
          </p>
          <p class="text-sm">
            <a href="https://x.com/" target="_blank">X</a> / <a href="mailto:x">Email</a>
          </p>
        </section>

        <section>
          <h3 class="text-xl border-b border-neutral-300 pb-2 mb-6 text-neutral-400 font-sans text-sm uppercase tracking-wider">Writing</h3>
          
          <ul class="list-none pl-0 space-y-3">
            {sortedPosts.map((post) => (
              <li class="group flex items-baseline justify-between">
                <a href={post.url} class="group-hover:text-blue-700">
                  {post.frontmatter.title}
                </a>
                <span class="text-xs font-sans text-neutral-400 ml-4 shrink-0">
                  {post.frontmatter.date}
                </span>
              </li>
            ))}
          </ul>
          
        </section>

      </article>

      <footer class="mt-32 text-xs font-sans text-neutral-400">
        <p>&copy; 2026 yuh. All rights reserved.</p>
      </footer>

    </main>
  </body>
</html>